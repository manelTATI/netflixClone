# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

# Port the API listens on (the Vite dev server proxies /api to this port)
PORT=5000

# MongoDB connection string (accounts and synced "My List").
# The catalog, search and guest watchlist work without it.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/netflix?retryWrites=true&w=majority

# Any long random string, used to sign login cookies
JWT_SECRET=replace_with_a_long_random_string

NODE_ENV=development

# TMDB credential: https://www.themoviedb.org/settings/api (free account).
# Either the short "API Key" or the long "API Read Access Token" works.
# Leave empty to run on the small built-in demo catalog.
TMDB_API_KEY=

# Optional: your country code (US, GB, FR, DE, ...) for "where to watch" and the
# "Free with ads" rows, since streaming catalogs differ by country. Defaults to US.
WATCH_REGION=US
